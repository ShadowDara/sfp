{
    "name": "samfile",
    "version": "0.0.1",
    "publisher": "shadowdara",
    "engines": {
        "vscode": "^1.90.0"
    },
    "activationEvents": [
        "onLanguage:samfile"
    ],
    "main": "./extension.js",
    "contributes": {
        "languages": [
            {
                "id": "samfile",
                "extensions": [
                    ".sam",
                    "Samfile"
                ]
            }
        ],
        "configuration": {
            "title": "Samfile",
            "properties": {
                "editor.semanticTokenColorCustomizations": {
                    "type": "object"
                }
            }
        }
    },
    "dependencies": {
        "vscode-languageclient": "^10.1.0"
    }
}
