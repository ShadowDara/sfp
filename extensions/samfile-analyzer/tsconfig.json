{
  "compilerOptions": {
    "module": "nodenext",
    "target": "es2022",
    "lib": [
      "es2022"
    ],
    "rootDir": "./src",
    "outDir": "./dist",
    "sourceMap": true,
    "strict": true,
    "types": [
      "node",
      "vscode"
    ],
    "moduleDetection": "force",
    "skipLibCheck": true
  },
  "include": [
    "src/**/*.ts"
  ]
}