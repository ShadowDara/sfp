// All following commands where added in 0.2.4 on 13.07.2026


# Docs
# a Task to pull the docs by Shadowdara for Shadowdara's projects from Github
# with curl.
#
# seg _build_in_docs
_build_in_docs:
    RUNLIN curl -# -o shadowdara_docs.html "https://raw.githubusercontent.com/shadowdara/docs/refs/heads/main/docs/index.html"
    RUNMAC curl -# -o shadowdara_docs.html "https://raw.githubusercontent.com/shadowdara/docs/refs/heads/main/docs/index.html"
    RUNWIN curl.exe -# -o shadowdara_docs.html "https://raw.githubusercontent.com/shadowdara/docs/refs/heads/main/docs/index.html"
    ECHO pulled the Docs from Github with curl


# Init
# a Task to create a new samfile
#
# seg _build_in_init
_build_in_init:
    TOUCH samfile
    APPEND samfile '# This is a new samfile'
    APPEND samfile '#'
    APPEND samfile '# Visit the Link to gain more Infos about samfiles'
    APPEND samfile '# https://shadowdara.github.io/docs/#/samfile'
    APPEND samfile '#'


# Add samfile language
# a Task to add the samfile as Shell lang to the gitignore file
#
# seg _build_in_samfile_lang
_build_in_samfile_lang:
    APPEND .gitattributes '# mark samfile as shell'
    APPEND .gitattributes "samfile linguist-language=Shell"


# Build Process for CMake (has Shortcut)
#
# seg _build_in_cmake
_build_in_cmake:
    RUN cmake -S . -B build
    RUN cmake --build build


# Build Process for CMake Release (has Shortcut)
#
# seg _build_in_cmake_r
_build_in_cmake_r:
    RUN cmake -S . -B build -DCMAKE_BUILD_TYPE=Release
    RUN cmake --build build


