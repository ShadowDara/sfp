# Docs WGET
# a Task to pull the docs by Shadowdara for Shadowdara's projects from Github
# with wget.
#
# seg _build_in_docs_wget
_build_in_docs_wget:
    RUN wget -O shadowdara_docs.html https://raw.githubusercontent.com/shadowdara/docs/refs/heads/main/docs/index.html
    ECHO pulled the Docs from Github with wget


# Gist Buildin samfile
# a Task which clones the buildin samfile Gist from Github
#
# seg
_build_in_samfile:
    RUN git clone https://gist.github.com/efa77c93aa83301c20b759bfae496d85.git


